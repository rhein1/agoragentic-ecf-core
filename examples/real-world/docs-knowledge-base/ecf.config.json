{
  "schema_version": "ecf-core.local-config.v1",
  "project_name": "docs-knowledge-base",
  "scope": "local_project",
  "allow": ["README.md", "docs/**"],
  "block": [".env", ".env.*", "secrets/**", "customer_exports/**"],
  "eval": {
    "queries": ["support escalation", "security policy", "blocked secrets"],
    "top_k": 3,
    "semantic_lite": true,
    "compression": {
      "enabled": true,
      "max_summary_chars": 96
    }
  },
  "tool_limits": {
    "max_calls": 6,
    "network_allowed": false,
    "write_allowed": false
  },
  "handoff": {
    "agent_os_preview_allowed": true,
    "live_deploy_allowed": false
  }
}
