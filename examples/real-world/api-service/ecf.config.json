{
  "schema_version": "ecf-core.local-config.v1",
  "project_name": "api-service",
  "scope": "agent_os_preview",
  "allow": ["README.md", "docs/**", "openapi.yaml"],
  "block": [".env", ".env.*", "secrets/**", "private_payloads/**"],
  "eval": {
    "queries": ["openapi endpoint", "api auth boundary", "agent os preview"],
    "top_k": 3,
    "semantic_lite": true,
    "compression": {
      "enabled": true,
      "max_summary_chars": 96
    }
  },
  "tool_limits": {
    "max_calls": 8,
    "network_allowed": false,
    "write_allowed": false
  },
  "handoff": {
    "agent_os_preview_allowed": true,
    "live_deploy_allowed": false
  }
}
